<Project Sdk="Microsoft.NET.Sdk">

  <!-- The runnable tray app (.exe). The only project allowed to use Windows APIs and WinForms. -->
  <PropertyGroup>
    <!-- WinExe = Windows GUI app: no console window appears when it starts. -->
    <OutputType>WinExe</OutputType>
    <!-- The Windows version suffix enables Windows-only APIs (needed later for toast notifications). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic Host: DI container, configuration, logging, and start/stop of background services. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Adds ValidateDataAnnotations(): checks the [Range] attributes on our options classes. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the settings file next to the .exe, where the Host looks for it. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActivityNotifier.Core\ActivityNotifier.Core.csproj" />
    <ProjectReference Include="..\ActivityNotifier.Infrastructure\ActivityNotifier.Infrastructure.csproj" />
  </ItemGroup>

</Project>
