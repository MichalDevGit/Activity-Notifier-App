<Project Sdk="Microsoft.NET.Sdk">

  <!-- The runnable tray app (.exe). The only project allowed to use Windows APIs and WinForms. -->
  <PropertyGroup>
    <!-- WinExe = Windows GUI app: no console window appears when it starts. -->
    <OutputType>WinExe</OutputType>
    <!-- The Windows version suffix enables Windows-only APIs (needed later for toast notifications). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActivityNotifier.Core\ActivityNotifier.Core.csproj" />
    <ProjectReference Include="..\ActivityNotifier.Infrastructure\ActivityNotifier.Infrastructure.csproj" />
  </ItemGroup>

</Project>
