<!--
  Central Package Management: projects say WHICH packages they use (<PackageReference Include="..." />),
  and this file says WHICH VERSION. One place to upgrade; all projects stay in sync.
  Packages are added here only in the milestone that first uses them.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
