<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same Windows target as the App project, because it references it. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- xUnit v3 test projects are small runnable programs. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      CS1591: tests do not need XML doc comments.
      CA1707: test names use underscores by convention (Method_Scenario_ExpectedResult).
    -->
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ActivityNotifier.App\ActivityNotifier.App.csproj" />
  </ItemGroup>

</Project>
