<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are small runnable programs. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      CS1591: tests do not need XML doc comments.
      CA1707: test names use underscores by convention (Method_Scenario_ExpectedResult).
    -->
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Global using: every test file can use [Fact] and Assert without writing 'using Xunit;'. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ActivityNotifier.Infrastructure\ActivityNotifier.Infrastructure.csproj" />
  </ItemGroup>

</Project>
